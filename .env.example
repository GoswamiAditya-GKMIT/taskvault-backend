# =============================================================================
# .env.example — Production environment variables for TaskVault Backend
# Copy this to .env on your EC2 server and fill in every value.
# NEVER commit the real .env to Git.
# =============================================================================

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-super-secret-django-key-here

# ── New Relic APM ─────────────────────────────────────────────────────────────
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=TaskVault

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=t
POSTGRES_USER=t
POSTGRES_PASSWORD=your_strong_db_password
POSTGRES_HOST=db         # Docker service name — NOT localhost
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
CACHES_LOCATIONS=redis://redis:6379/1   # Docker service name — NOT 127.0.0.1
CELERY_BROKER_URL=redis://redis:6379/2  # Docker service name — NOT 127.0.0.1

# ── Email (Brevo SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST_USER=your-smtp-user@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-password
DEFAULT_FROM_EMAIL=

# ── Super Admin ───────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=your_strong_admin_password

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://taskvault.site
BASE_URL=https://taskvault.site/api/v1
REGISTER_INVITE_LINK_PATH=https://taskvault.site/invite
